+        image_ptr2 = nullptr;
+    }
+    if(original_image_ptr) {
+        CVI_VI_ReleaseChnFrame(ViPipe, ViChn, (VIDEO_FRAME_INFO_S *)original_image_ptr);
+        delete (VIDEO_FRAME_INFO_S *)original_image_ptr;
+        original_image_ptr = nullptr;
+    }
